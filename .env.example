PORT=3000
BASE_URL=http://localhost:3000

# Optional: put your Steam Web API key here.
# Do NOT share this value with anyone.
STEAM_API_KEY=

# Used by CS2 heartbeat endpoint if you later use a plugin.
SERVER_API_KEY=change-this-secret

# Optional Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
